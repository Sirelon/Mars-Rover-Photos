default_platform(:ios)


APP_IDENTIFIER = "com.sirelon.marsroverphotos"
IOS_PROJECT    = "iosApp/iosApp.xcodeproj"
IOS_SCHEME     = "iosApp"
ANDROID_AAB         = "androidApp/build/outputs/bundle/release/androidApp-release.aab"
GOOGLE_PLAY_KEY     = "fastlane/google-play-key.json"
ANDROID_APK         = "androidApp/build/outputs/apk/release/androidApp-release.apk"

# Samsung Galaxy Store (Content Publish API). The listing there predates Play App Signing, so Samsung
# still expects the ORIGINAL certificate: the lane re-signs the APK with the keystore named in
# fastlane/galaxy-store.env (gitignored: GALAXY_KEYSTORE, GALAXY_KEY_ALIAS, GALAXY_KS_PASS,
# GALAXY_KEY_PASS) — upload.jks only satisfies Play. The service account is created in Seller Portal
# under Assistance > API Service; its private key is fastlane/galaxy-store-key.pem (gitignored).
GALAXY_SERVICE_ACCOUNT_ID = "1c0cd0bd-a91f-4d7d-9344-5619d2abcf3e"
GALAXY_CONTENT_ID         = "000002166436" # Seller Portal id of the app listing
GALAXY_API                = "https://devapi.samsungapps.com"
GALAXY_APK                = "androidApp/build/outputs/apk/release/androidApp-release-galaxy.apk"

ASC_KEY_ID       = "G5TTXS7GV3"
ASC_ISSUER_ID    = "8873b38c-775e-4a3e-baf5-4e2bada765a8"
# Plain Ruby File.* calls in this Fastfile run relative to the fastlane/
# folder itself, not the repo root actions like gradle()/build_app() resolve
# their string params against, so anchor these to __dir__ explicitly.
ASC_KEY_FILEPATH = File.expand_path("AuthKey_G5TTXS7GV3.p8", __dir__)
REPO_ROOT        = File.expand_path("..", __dir__)
GALAXY_KEY_FILEPATH = File.expand_path("galaxy-store-key.pem", __dir__)
GALAXY_ENV_FILEPATH = File.expand_path("galaxy-store.env", __dir__)

# Release-notes staging, written by the store-release skill. Gitignored: mechanical inputs for
# supply/deliver, regenerated every release, not content worth versioning. release_notes.txt is one
# text serving both stores, so the Android tree (where supply's layout requires it) is the single
# copy, copied as-is into the iOS tree. promotional_text.txt is Apple-only (Play has no equivalent
# field) and lives only under the iOS tree.
ANDROID_METADATA_DIR = File.join(REPO_ROOT, ".claude/tmp/release-metadata/android")
IOS_METADATA_DIR     = File.join(REPO_ROOT, ".claude/tmp/release-metadata/ios")
STORE_LOCALE         = "en-US"
PLAY_CHANGELOG_LIMIT = 500

# Store listing text (title, descriptions, keywords). Committed, unlike the release-notes staging
# above: it changes rarely and is reviewed like code. Deliberately not fastlane/metadata/, which
# supply and deliver pick up on their own. Every release pushes it through `android changelog` and
# `ios release_notes`, so an edit here ships with the next release.
LISTING_DIR = File.join(REPO_ROOT, "fastlane/listing")
# field => [store limit, unit]. Apple counts keywords in bytes, everything else in characters.
PLAY_LISTING_LIMITS = {
  "title" => [30, :chars], "short_description" => [80, :chars], "full_description" => [4000, :chars]
}.freeze
IOS_LISTING_LIMITS = {
  "name" => [30, :chars], "subtitle" => [30, :chars], "keywords" => [100, :bytes],
  "description" => [4000, :chars]
}.freeze
# Samsung reuses the Play text. Seller Portal accepts a longer short description than the API docs
# claim (the live listing holds 77 bytes), so the limits here are the ones the portal enforces.
GALAXY_LISTING_LIMITS = {
  "title" => [100, :bytes], "short_description" => [80, :chars], "full_description" => [4000, :bytes]
}.freeze
GALAXY_NEW_FEATURE_LIMIT = 4000

# buildSrc/AppVersion.kt is the single source of truth for the version on every platform.
def app_version(field)
  path = File.join(REPO_ROOT, "buildSrc/src/main/kotlin/AppVersion.kt")
  UI.user_error!("Not found: #{path}") unless File.exist?(path)
  value = File.read(path)[/const val #{field} = "?([\w.]+)"?/, 1]
  UI.user_error!("No `const val #{field}` in #{path}") unless value
  value
end

def staged_changelog_path
  File.join(ANDROID_METADATA_DIR, STORE_LOCALE, "changelogs", "#{app_version('code')}.txt")
end

# The one changelog both stores use. ENV["CHANGELOG"] overrides it; the generic string is the floor,
# so an unstaged release still ships something truthful rather than failing at upload.
def store_changelog
  path = staged_changelog_path
  return File.read(path, encoding: "UTF-8").strip if File.exist?(path)

  UI.important("No changelog staged at #{path} — falling back")
  ENV["CHANGELOG"] || "Bug fixes and improvements"
end

# Reads fastlane/listing/<store>/en-US/<field>.txt into { field => text } and refuses anything over
# the store's limit, so an overlong line fails here rather than as an API error mid-upload.
def listing_texts(store, limits)
  limits.each_with_object({}) do |(field, (limit, unit)), texts|
    path = File.join(LISTING_DIR, store, STORE_LOCALE, "#{field}.txt")
    UI.user_error!("Missing #{path}") unless File.exist?(path)

    text = File.read(path, encoding: "UTF-8").strip
    size = unit == :bytes ? text.bytesize : text.length
    UI.user_error!("#{path} is #{size} #{unit} — the store limit is #{limit}") if size > limit
    texts[field] = text
  end
end

# ---------------------------------------------------------------------------
# Samsung Galaxy Store helpers (Content Publish API)
# ---------------------------------------------------------------------------

# Newest apksigner in the SDK: ANDROID_HOME first, then the default macOS SDK location.
def apksigner_path
  sdk = ENV["ANDROID_HOME"] || ENV["ANDROID_SDK_ROOT"] || File.expand_path("~/Library/Android/sdk")
  candidates = Dir.glob(File.join(sdk, "build-tools", "*", "apksigner")).sort_by do |p|
    Gem::Version.new(File.basename(File.dirname(p)))
  rescue ArgumentError
    Gem::Version.new("0")
  end
  UI.user_error!("No apksigner under #{sdk}/build-tools — install Android build-tools") if candidates.empty?
  candidates.last
end

def galaxy_env
  UI.user_error!("Missing #{GALAXY_ENV_FILEPATH} — see the Galaxy Store section in AGENTS.md") unless File.exist?(GALAXY_ENV_FILEPATH)
  require "dotenv"
  Dotenv.load(GALAXY_ENV_FILEPATH)
  %w[GALAXY_KEYSTORE GALAXY_KEY_ALIAS GALAXY_KS_PASS GALAXY_KEY_PASS].each do |name|
    UI.user_error!("#{name} is not set in #{GALAXY_ENV_FILEPATH}") if ENV[name].to_s.empty?
  end
end

# Re-signs the Play-signed APK with the Galaxy Store certificate. apksigner replaces the signature
# only, so the binary itself is the one Play got. Passwords go through the environment, never argv.
def galaxy_sign(apk)
  galaxy_env
  keystore = File.expand_path(ENV["GALAXY_KEYSTORE"], REPO_ROOT)
  UI.user_error!("Galaxy keystore not found: #{keystore}") unless File.exist?(keystore)
  out = File.join(REPO_ROOT, GALAXY_APK)
  sh(
    apksigner_path, "sign", "--ks", keystore, "--ks-key-alias", ENV["GALAXY_KEY_ALIAS"],
    "--ks-pass", "env:GALAXY_KS_PASS", "--key-pass", "env:GALAXY_KEY_PASS",
    "--out", out, File.join(REPO_ROOT, apk),
    log: false
  )
  out
end

def galaxy_token
  unless File.exist?(GALAXY_KEY_FILEPATH)
    UI.user_error!("Missing #{GALAXY_KEY_FILEPATH} — download it from Seller Portal > Assistance > API Service")
  end
  require "jwt"
  require "openssl"
  now = Time.now.to_i
  jwt = JWT.encode(
    { iss: GALAXY_SERVICE_ACCOUNT_ID, scopes: ["publishing"], iat: now, exp: now + 20 * 60 },
    OpenSSL::PKey::RSA.new(File.read(GALAXY_KEY_FILEPATH)), "RS256"
  )
  body = galaxy_request(:post, "/auth/accessToken", headers: { "Authorization" => "Bearer #{jwt}" })
  body.dig("createdItem", "accessToken") || UI.user_error!("Galaxy token response had no accessToken: #{body}")
end

# One JSON round-trip. Samsung answers 200 with an errorCode/errorMsg body for most failures, and
# 204 with no body for contentSubmit, so success means "2xx and no error field".
def galaxy_request(method, path, token: nil, headers: {}, json: nil, form: nil, base: GALAXY_API)
  require "net/http"
  require "json"
  uri = URI("#{base}#{path}")
  req = Net::HTTP.const_get(method.to_s.capitalize).new(uri)
  req["Authorization"] = "Bearer #{token}" if token
  req["service-account-id"] = GALAXY_SERVICE_ACCOUNT_ID
  headers.each { |k, v| req[k] = v }
  if form
    req.set_form(form, "multipart/form-data")
  else
    req["content-type"] = "application/json"
    req.body = json ? JSON.generate(json) : ""
  end
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: true, read_timeout: 600) { |http| http.request(req) }
  UI.user_error!("Galaxy #{method.to_s.upcase} #{path} -> HTTP #{res.code}: #{res.body}") unless res.code.start_with?("2")
  return {} if res.body.to_s.strip.empty?

  body = JSON.parse(res.body)
  body = body.first if body.is_a?(Array) && path.include?("contentInfo")
  if body.is_a?(Hash) && (body["errorCode"] || (body["resultCode"] && body["resultCode"] != "0000"))
    UI.user_error!("Galaxy #{method.to_s.upcase} #{path} failed: #{body}")
  end
  body
end

def galaxy_content_info(token)
  galaxy_request(:get, "/seller/contentInfo?contentId=#{GALAXY_CONTENT_ID}", token: token)
end

# Uploads a file and returns its fileKey. The upload host differs from the API host and is handed
# back by createUploadSessionId, so it is not hardcoded.
def galaxy_upload(token, path)
  session = galaxy_request(:post, "/seller/createUploadSessionId", token: token)
  upload_uri = URI(session["url"])
  UI.message("Uploading #{File.basename(path)} (#{(File.size(path) / 1024.0 / 1024).round(1)} MB) to Galaxy Store")
  File.open(path, "rb") do |file|
    body = galaxy_request(
      :post, upload_uri.path, token: token, base: "#{upload_uri.scheme}://#{upload_uri.host}",
      form: [
        ["file", file, { filename: File.basename(path), content_type: "application/vnd.android.package-archive" }],
        ["sessionId", session["sessionId"]]
      ]
    )
    body["fileKey"] || UI.user_error!("Galaxy upload returned no fileKey: #{body}")
  end
end

# ---------------------------------------------------------------------------
# iOS
# ---------------------------------------------------------------------------

platform :ios do
  before_all do
    next unless File.exist?(ASC_KEY_FILEPATH)

    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_FILEPATH
    )
  end

  # Both credentials are gitignored, so a fresh worktree has neither. Check them before the archive
  # rather than after it — build_app is the longest step in the whole release.
  private_lane :ensure_credentials do
    unless File.exist?(ASC_KEY_FILEPATH)
      UI.user_error!("Missing #{ASC_KEY_FILEPATH} — App Store Connect uploads need the API key")
    end
    plist = File.join(REPO_ROOT, "iosApp/iosApp/GoogleService-Info.plist")
    unless File.exist?(plist)
      UI.user_error!("Missing #{plist} — copy iosApp/GoogleService-Info.template.plist and fill it in")
    end
  end

  desc "Sync MARKETING_VERSION / CURRENT_PROJECT_VERSION from buildSrc/AppVersion.kt"
  private_lane :sync_version do
    # buildSrc/AppVersion.kt is the single source of truth for the app version;
    # the existing Gradle task pushes it into the Xcode project.
    gradle(task: "syncIosVersion")
  end

  # Xcode can refresh a provisioning profile only when it can reach the developer portal. This Mac
  # has no Apple ID signed into Xcode, so xcodebuild authenticates with the App Store Connect API
  # key. gym forwards xcargs to both the archive and the export; without the key the export fails
  # with "No Accounts" as soon as the cached App Store profile predates the current distribution
  # certificate. Do not repeat these flags in export_xcargs: xcodebuild rejects duplicates.
  def provisioning_xcargs
    "-allowProvisioningUpdates " \
      "-authenticationKeyPath #{ASC_KEY_FILEPATH.shellescape} " \
      "-authenticationKeyID #{ASC_KEY_ID.shellescape} " \
      "-authenticationKeyIssuerID #{ASC_ISSUER_ID.shellescape}"
  end

  # The App Store profile for the export. Xcode's cached "iOS Team Store Provisioning Profile"
  # goes stale whenever the distribution certificate is reissued, and with no Apple ID signed into
  # Xcode its automatic repair fails ("No Accounts" / "Cloud signing permission error"). sigh
  # fetches or creates a matching profile through the App Store Connect API key, and gym then uses
  # it for the export's provisioningProfiles mapping; the archive itself stays on automatic signing.
  def app_store_profile
    get_provisioning_profile(
      app_identifier: APP_IDENTIFIER,
      output_path: File.join(Dir.tmpdir, "marsroverphotos-profiles")
    )
  end

  desc "Build and upload a new beta to TestFlight"
  lane :beta do
    ensure_credentials
    sync_version
    app_store_profile
    Bundler.with_unbundled_env do
      build_app(
        project: IOS_PROJECT,
        scheme: IOS_SCHEME,
        export_method: "app-store",
        xcargs: provisioning_xcargs
      )
    end
    upload_to_testflight(
      # With a changelog supplied, pilot waits just long enough for the build to appear in App Store
      # Connect to set it, then skips the remaining processing steps.
      skip_waiting_for_build_processing: true,
      changelog: store_changelog
    )
  end

  desc "Build and upload to App Store (does not submit for review)"
  lane :release do
    ensure_credentials
    sync_version
    app_store_profile
    Bundler.with_unbundled_env do
      build_app(
        project: IOS_PROJECT,
        scheme: IOS_SCHEME,
        export_method: "app-store",
        xcargs: provisioning_xcargs
      )
    end
    upload_to_app_store(
      app_identifier: APP_IDENTIFIER,
      submit_for_review: false,
      automatic_release: false,
      skip_metadata: true,
      skip_screenshots: true
    )
  end

  desc "Upload the listing text, 'What's New' and promotional text to the current version draft (metadata only, no binary)"
  lane :release_notes do
    ensure_credentials
    notes_path = File.join(IOS_METADATA_DIR, STORE_LOCALE, "release_notes.txt")
    unless File.exist?(notes_path)
      UI.user_error!("Missing #{notes_path} — stage it first (the store-release skill writes it)")
    end
    promo_path = File.join(IOS_METADATA_DIR, STORE_LOCALE, "promotional_text.txt")

    params = {
      app_identifier: APP_IDENTIFIER,
      app_version: app_version("name"),
      release_notes: { STORE_LOCALE => File.read(notes_path, encoding: "UTF-8").strip },
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true, # no interactive HTML-preview confirmation
      # precheck's in-app-purchase check doesn't support App Store Connect API key auth yet ("cannot
      # check In-app purchases with the App Store Connect API Key"), and it otherwise runs even
      # though submit_for_review is false. This app has no IAP and isn't submitting here, so skip it.
      run_precheck_before_submit: false
    }
    if File.exist?(promo_path)
      params[:promotional_text] = { STORE_LOCALE => File.read(promo_path, encoding: "UTF-8").strip }
    else
      UI.important("No promotional text staged at #{promo_path} — leaving Promotional Text untouched")
    end
    # Name and subtitle live on App Info rather than the version, but App Info is editable exactly
    # while a version draft is, so the same call covers them.
    listing_texts("ios", IOS_LISTING_LIMITS).each do |field, text|
      params[field.to_sym] = { STORE_LOCALE => text }
    end

    # Deliberately no metadata_path: it makes deliver mirror the WHOLE local folder onto App Store
    # Connect, and a field whose file isn't staged locally is not guaranteed to survive that sync —
    # exactly the "incomplete staging tree overwrites the live listing" risk already called out for
    # Play's supply below. Passing each field as an explicit per-locale hash touches only What's
    # New, Promotional Text, name, subtitle, keywords and description; screenshots, URLs and
    # categories are never in scope.
    upload_to_app_store(**params)
  end
end

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------

platform :android do
  # androidApp/build.gradle.kts applies the release signing config ONLY if keystore.properties
  # exists. Without it bundleRelease still succeeds and emits an unsigned aab that Play rejects
  # minutes later, at upload. Fail here instead.
  private_lane :ensure_signing do
    props = File.join(REPO_ROOT, "keystore.properties")
    unless File.exist?(props)
      UI.user_error!("Missing keystore.properties — bundleRelease would produce an UNSIGNED aab that Play rejects")
    end
    store_file = File.read(props)[/^storeFile\s*=\s*(.+)$/, 1]&.strip
    UI.user_error!("keystore.properties has no storeFile") unless store_file
    # Gradle resolves a relative storeFile against the androidApp module dir (file() in that
    # module's build script), so resolve it the same way here.
    resolved = File.expand_path(store_file, File.join(REPO_ROOT, "androidApp"))
    UI.user_error!("Keystore not found: #{resolved} (from keystore.properties)") unless File.exist?(resolved)
  end

  desc "Build release AAB and upload to Play Store internal testing"
  lane :beta do
    ensure_signing
    gradle(task: ":androidApp:bundleRelease")
    upload_to_play_store(
      track: "internal",
      aab: ANDROID_AAB,
      json_key: GOOGLE_PLAY_KEY,
      skip_upload_apk: true
    )
  end

  desc "Attach the staged release notes to the internal-track release, then upload the listing text (no binary upload)"
  lane :changelog do
    code = app_version("code").to_i
    path = staged_changelog_path
    UI.user_error!("No changelog staged for version code #{code} at #{path}") unless File.exist?(path)

    length = File.read(path, encoding: "UTF-8").strip.length
    if length > PLAY_CHANGELOG_LIMIT
      UI.user_error!("Changelog is #{length} characters — Google Play's limit is #{PLAY_CHANGELOG_LIMIT}")
    end
    UI.message("Attaching #{length}-character changelog to version code #{code}")

    upload_to_play_store(
      package_name: APP_IDENTIFIER,
      track: "internal",
      version_code: code,
      json_key: GOOGLE_PLAY_KEY,
      metadata_path: ANDROID_METADATA_DIR,
      skip_upload_apk: true,
      skip_upload_aab: true,
      # Release notes only. With a metadata_path set, supply otherwise walks EVERY locale folder
      # under it and runs listing.save plus image and screenshot syncs — an incomplete staging tree
      # would then overwrite the live store listing.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    listing
  end

  desc "Upload the listing text (title, short and full description). Pass validate_only:true to check without publishing"
  lane :listing do |options|
    listing_texts("android", PLAY_LISTING_LIMITS) # limits check only; supply reads the files itself

    upload_to_play_store(
      package_name: APP_IDENTIFIER,
      # supply only uploads metadata alongside a release, so it needs one to attach to. The listing
      # itself is app-wide: it goes live after Google's review, whatever the track.
      track: "internal",
      version_code: app_version("code").to_i,
      json_key: GOOGLE_PLAY_KEY,
      metadata_path: File.join(LISTING_DIR, "android"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      # supply sets only the fields that have a .txt file (video stays untouched), then saves.
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: options[:validate_only] || false
    )
  end

  desc "Promote the latest internal build to production on Play Store"
  lane :release do
    # Without an explicit version_code supply refuses as soon as the internal track holds more than
    # one release ("has more than one release - use :version_code to filter").
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      version_code: app_version("code").to_i,
      json_key: GOOGLE_PLAY_KEY
    )
  end

  desc "Build release AAB without uploading"
  lane :build do
    ensure_signing
    gradle(task: ":androidApp:bundleRelease")
  end

  desc "Build the release APK, re-sign it with the Galaxy Store key, push listing text + changelog, and submit to Samsung for review. Pass skip_build:true to reuse the APK already in build/outputs"
  lane :galaxy do |options|
    ensure_signing
    galaxy_env # fail on a missing keystore or password before the long build
    listing = listing_texts("android", GALAXY_LISTING_LIMITS)
    changelog = store_changelog
    if changelog.length > GALAXY_NEW_FEATURE_LIMIT
      UI.user_error!("Changelog is #{changelog.length} characters — Galaxy Store's limit is #{GALAXY_NEW_FEATURE_LIMIT}")
    end

    token = galaxy_token
    info = galaxy_content_info(token)
    # Anything else means Samsung is reviewing a submission, and a second one is refused.
    unless %w[FOR_SALE REGISTERING].include?(info["contentStatus"])
      UI.user_error!("Galaxy Store listing is #{info['contentStatus']} — wait for the current review to finish")
    end
    code = app_version("code").to_i
    if (info["binaryList"] || []).any? { |b| b["versionCode"].to_i >= code }
      UI.user_error!("Galaxy Store already holds version code #{code} or newer — bump the version first")
    end

    gradle(task: ":androidApp:assembleRelease") unless options[:skip_build]
    apk = galaxy_sign(ANDROID_APK)

    # contentUpdate moves the listing into REGISTERING (Seller Portal's "Updating"), which the binary
    # and submit calls require. Omitted fields keep their current values; the three echoed back from
    # contentInfo are mandatory on every call.
    galaxy_request(:post, "/seller/contentUpdate", token: token, json: {
      contentId: GALAXY_CONTENT_ID,
      defaultLanguageCode: info["defaultLanguageCode"],
      paid: info["paid"],
      publicationType: info["publicationType"],
      appTitle: listing["title"],
      shortDescription: listing["short_description"],
      longDescription: listing["full_description"].gsub(%r{</?b>}, ""), # Samsung renders no HTML
      newFeature: changelog
    })

    file_key = galaxy_upload(token, apk)
    # Existing binaries stay attached on purpose: Samsung serves each to the devices it targets, and
    # the old ones may be the only build left for very old Android versions.
    added = galaxy_request(:post, "/seller/v2/content/binary", token: token, json: {
      contentId: GALAXY_CONTENT_ID, filekey: file_key, gms: "Y"
    })
    UI.message("Attached binary seq #{added.dig('data', 'binarySeq')} (version code #{code})")

    galaxy_request(:post, "/seller/contentSubmit", token: token, json: { contentId: GALAXY_CONTENT_ID })
    UI.success("Submitted #{app_version('name')} (#{code}) to Galaxy Store review")
  end
end
